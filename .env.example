# === LLM provider (Strategist + Critic agents) ===
# auto = first configured of anthropic -> openai -> ollama. Or force: openai | anthropic | ollama
LLM_PROVIDER=auto

# OpenAI - leave the placeholder to skip
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Anthropic (Claude) - leave the placeholder to skip
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-opus-5

# Ollama - local models, no key. Set OLLAMA_MODEL to enable (e.g. llama3.1, qwen2.5).
# Tool calling needs a tool-capable model; others fall back to static mode automatically.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# Agent behaviour
# tools = strategist queries the data with function calls; static = single prompt
STRATEGIST_MODE=tools
AGENT_MAX_TOOL_ROUNDS=6
# Second pass that fact-checks the report against the numbers
CRITIC_ENABLED=true

# === Backend (FastAPI) ===
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Maximum upload size in megabytes
MAX_UPLOAD_MB=25
# Comma-separated allowed origins, or * for any (local dev)
CORS_ORIGINS=*

# === Observability ===
# Requests per minute per client on POST /analyze (0 = unlimited)
RATE_LIMIT_PER_MINUTE=10
# "text" or "json" (one JSON object per line, for log aggregators)
LOG_FORMAT=text
# Error tracking — leave blank to disable
SENTRY_DSN=

# === Access control (optional) ===
# When set, clients must send this value in an X-API-Key header.
# Leave blank for open local development.
API_KEY=

# === Vercel / large uploads ===
# Hosts the API may download `file_url` inputs from (comma-separated, * wildcards).
# Default covers Vercel Blob. Leave as-is unless you host uploads elsewhere.
FILE_URL_ALLOWED_HOSTS=*.public.blob.vercel-storage.com
