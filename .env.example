# === OpenAI (Stage 3: Recommendation Agent) ===
# Leave the placeholder in place to run without AI recommendations
# (tick "Skip AI Recommendations" in the UI, or pass skip_recommendations=true).
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# === Backend (FastAPI) ===
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Maximum upload size in megabytes
MAX_UPLOAD_MB=25
# Comma-separated allowed origins, or * for any (local dev)
CORS_ORIGINS=*

# === Frontend (Streamlit) ===
# Where the Streamlit app finds the backend
BACKEND_URL=http://localhost:8000
