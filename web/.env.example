# URL of the FastAPI backend (no trailing slash). The browser calls it directly.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Client-side upload cap in MB — keep equal to MAX_UPLOAD_MB on the backend.
NEXT_PUBLIC_MAX_UPLOAD_MB=25

# Large uploads (> 4.5 MB) when the API runs on Vercel: the browser uploads to
# Vercel Blob and passes a URL. Set automatically when a Blob store is connected
# to the Vercel project; leave blank locally.
BLOB_READ_WRITE_TOKEN=

# === Monthly email re-runs (Vercel Cron → /api/cron/monthly) ===
# Resend API key and verified sender; leave blank to disable scheduling.
RESEND_API_KEY=
EMAIL_FROM="AI Business Consultant <reports@yourdomain.com>"
# Vercel sets CRON_SECRET automatically when a cron is configured; also signs unsubscribe links.
CRON_SECRET=
# Server-side URL of the API for the cron job (defaults to NEXT_PUBLIC_API_URL) and its key if set
API_URL=
API_KEY=
# Public URL of this app, used in email links (defaults to the request origin)
APP_URL=
