# URL of the FastAPI backend (no trailing slash). The browser calls it directly.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Client-side upload cap in MB — keep equal to MAX_UPLOAD_MB on the backend.
NEXT_PUBLIC_MAX_UPLOAD_MB=25

# Large uploads (> 4.5 MB) when the API runs on Vercel: the browser uploads to
# Vercel Blob and passes a URL. Set automatically when a Blob store is connected
# to the Vercel project; leave blank locally.
BLOB_READ_WRITE_TOKEN=
